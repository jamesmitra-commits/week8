                        <div class="bg-indigo-50 border-2 border-indigo-200 rounded-2xl p-3 text-center flex flex-col items-center">
                            <span class="text-5xl md:text-7xl">🎮</span>
                            <p class="font-extrabold text-base md:text-xl text-indigo-800 mt-2">Play Games</p>
                        </div>
                        <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3 text-center flex flex-col items-center">
                            <span class="text-5xl md:text-7xl">📖</span>
                            <p class="font-extrabold text-base md:text-xl text-amber-800 mt-2">Read & Learn</p>
                        </div>
                        <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-3 text-center flex flex-col items-center">
                            <span class="text-5xl md:text-7xl">🎨</span>
                            <p class="font-extrabold text-base md:text-xl text-emerald-800 mt-2">Draw & Create</p>
                        </div>
                    </div>
                `
            },
            {
                title: "Computer Friends Activity! 🤝",
                content: `
                    <div class="bg-yellow-50 border-2 border-yellow-300 rounded-2xl p-5 text-center max-w-2xl my-auto shadow">
                        <span class="text-6xl md:text-8xl mb-2 inline-block">🗣️</span>
                        <h3 class="text-xl md:text-3xl font-extrabold text-amber-800 mb-2">Think - Pair - Share!</h3>
                        <p class="text-lg md:text-2xl font-extrabold text-slate-800 leading-relaxed space-y-1">
                            1. Think about your favorite computer.<br>
                            2. Turn to a partner.<br>
                            3. Share what functions you use it for!
                        </p>
                    </div>
                `
            }
        ];

        let currentSlide = 0;

        function renderSlide() {
            const slide = presentationSlides[currentSlide];
            document.getElementById('slide-badge').innerText = `Slide ${currentSlide + 1} of ${presentationSlides.length}`;
            
            // Render Dots
            const dotsContainer = document.getElementById('slide-dots');
            dotsContainer.innerHTML = presentationSlides.map((_, idx) => `
                <div class="w-2.5 h-2.5 md:w-3.5 md:h-3.5 rounded-full ${idx === currentSlide ? 'bg-sky-500 scale-125' : 'bg-sky-200'} transition-all"></div>
            `).join('');

            // Render Content
            document.getElementById('slide-content').innerHTML = `
                <h2 class="text-xl md:text-3xl font-extrabold text-sky-700 mb-2 shrink-0">${slide.title}</h2>
                <div class="flex-1 min-h-0 flex flex-col justify-center items-center w-full">${slide.content}</div>
            `;

            document.getElementById('btn-prev-slide').disabled = currentSlide === 0;
            document.getElementById('btn-prev-slide').style.opacity = currentSlide === 0 ? "0.4" : "1";
        }

        function changeSlide(direction) {
            playSound('click');
            currentSlide += direction;
            if (currentSlide < 0) currentSlide = 0;
            if (currentSlide >= presentationSlides.length) currentSlide = presentationSlides.length - 1;
            renderSlide();
        }


        /* Activity 1: Drag and Drop Matching Questions */
        const matchingQuestions = [
            {
                prompt: "Which device stays on your desk with a monitor, keyboard, mouse & CPU box?",
                rationale: "Correct! The Desktop Computer stays in one place on your desk!",
                options: [
                    { id: "desktop", text: "Desktop Computer", icon: "🖥️", isCorrect: true },
                    { id: "laptop", text: "Laptop Computer", icon: "💻", isCorrect: false },
                    { id: "tablet", text: "Tablet Computer", icon: "📱", isCorrect: false },
                    { id: "smartphone", text: "Smartphone", icon: "📲", isCorrect: false }
                ]
            },
            {
                prompt: "Which one folds closed like a notebook so you can carry it in your backpack?",
                rationale: "Correct! The Laptop folds closed so you can carry it in your backpack!",
                options: [
                    { id: "tablet", text: "Tablet Computer", icon: "📱", isCorrect: false },
                    { id: "laptop", text: "Laptop Computer", icon: "💻", isCorrect: true },
                    { id: "desktop", text: "Desktop Computer", icon: "🖥️", isCorrect: false },
                    { id: "smartphone", text: "Smartphone", icon: "📲", isCorrect: false }
                ]
            },
            {
                prompt: "Which touch screen device is used to draw art, read books & watch cartoons?",
                rationale: "Correct! The Tablet is a touch screen computer for drawing & reading!",
                options: [
                    { id: "desktop", text: "Desktop Computer", icon: "🖥️", isCorrect: false },
                    { id: "smartphone", text: "Smartphone", icon: "📲", isCorrect: false },
                    { id: "tablet", text: "Tablet Computer", icon: "📱", isCorrect: true },
                    { id: "laptop", text: "Laptop Computer", icon: "💻", isCorrect: false }
                ]
            },
            {
                prompt: "Which small pocket device CAN MAKE PHONE CALLS anywhere?",
                rationale: "Correct! The Smartphone fits in your pocket and makes phone calls!",
                options: [
                    { id: "smartphone", text: "Smartphone", icon: "📲", isCorrect: true },
                    { id: "tablet", text: "Tablet Computer", icon: "📱", isCorrect: false },
                    { id: "laptop", text: "Laptop Computer", icon: "💻", isCorrect: false },
                    { id: "desktop", text: "Desktop Computer", icon: "🖥️", isCorrect: false }
                ]
            },
            {
                prompt: "Which SMART MACHINE helps us learn, play games & watch cartoons?",
                rationale: "Correct! A computer is a smart machine that helps us learn and play!",
                options: [
                    { id: "smartmachine", text: "Smart Computer", icon: "🤖", isCorrect: true },
                    { id: "monitor", text: "Monitor Screen", icon: "📺", isCorrect: false },
                    { id: "keyboard", text: "Keyboard", icon: "⌨️", isCorrect: false },
                    { id: "mouse", text: "Computer Mouse", icon: "🖱️", isCorrect: false }
                ]
            }
        ];

        let currentMatchingIndex = 0;
        let matchingScore = 0;
        let matchingAnswered = false;
        let draggedOptionIndex = null;

        function initMatchingGame() {
            currentMatchingIndex = 0;
            matchingScore = 0;
            matchingAnswered = false;
            document.getElementById('matching-results').classList.add('hidden');
            document.getElementById('matching-container').classList.remove('hidden');
            document.getElementById('matching-header').classList.remove('hidden');
            loadMatchingQuestion();
        }

        function loadMatchingQuestion() {
            matchingAnswered = false;
            draggedOptionIndex = null;
            const q = matchingQuestions[currentMatchingIndex];

            document.getElementById('matching-slide-num').innerText = `Question ${currentMatchingIndex + 1} of ${matchingQuestions.length}`;
            document.getElementById('matching-prompt-text').innerText = q.prompt;
            document.getElementById('matching-feedback').classList.add('hidden');
            document.getElementById('btn-next-matching').classList.add('hidden');

            // Reset Drop Zone
            const dropTarget = document.getElementById('drop-target-zone');
            dropTarget.className = "w-full md:w-64 h-20 md:h-24 border-4 border-dashed border-white/90 bg-amber-500/40 rounded-2xl flex flex-col items-center justify-center text-center transition-all pulse-target shrink-0 p-1";
            document.getElementById('drop-zone-placeholder').classList.remove('hidden');
            document.getElementById('drop-zone-content').classList.add('hidden');
            document.getElementById('drop-zone-content').innerHTML = '';

            // Render Dots
            const dotsContainer = document.getElementById('matching-progress-dots');
            dotsContainer.innerHTML = matchingQuestions.map((_, idx) => `
                <div class="w-2.5 h-2.5 md:w-3.5 md:h-3.5 rounded-full ${idx === currentMatchingIndex ? 'bg-amber-500 scale-125' : 'bg-amber-200'} transition-all"></div>
            `).join('');

            // Render 4 Draggable Picture Options
            const optionsContainer = document.getElementById('matching-options');
            optionsContainer.innerHTML = q.options.map((opt, idx) => `
                <div id="drag-opt-${idx}"
                     draggable="true" 
                     ondragstart="handleDragStart(event, ${idx})"
                     onclick="handleOptionTap(${idx})"
                     class="draggable-card group bg-slate-50 border-2 md:border-4 border-slate-200 hover:border-amber-400 hover:bg-amber-50 rounded-2xl md:rounded-3xl p-2 md:p-3 flex flex-col items-center justify-center text-center transition-all duration-150 shadow hover:shadow-lg cursor-grab h-full min-h-0 w-full overflow-hidden">
                    <div class="flex-1 min-h-0 w-full bg-white rounded-xl md:rounded-2xl border-2 border-slate-100 flex items-center justify-center text-5xl md:text-7xl lg:text-8xl my-1 group-hover:scale-105 transition-transform pointer-events-none">
                        ${opt.icon}
                    </div>
                    <span class="text-xs md:text-lg font-extrabold text-slate-800 group-hover:text-amber-800 shrink-0 mt-1 pointer-events-none">${opt.text}</span>
                </div>
            `).join('');
        }

        /* Drag and Drop Handlers */
        function handleDragStart(e, index) {
            if (matchingAnswered) return;
            draggedOptionIndex = index;
            e.dataTransfer.setData("text/plain", index);
        }

        function handleDragOver(e) {
            e.preventDefault();
            if (matchingAnswered) return;
            document.getElementById('drop-target-zone').classList.add('bg-amber-300/80', 'scale-105');
        }

        function handleDragLeave(e) {
            if (matchingAnswered) return;
            document.getElementById('drop-target-zone').classList.remove('bg-amber-300/80', 'scale-105');
        }

        function handleDrop(e) {
            e.preventDefault();
            if (matchingAnswered) return;
            document.getElementById('drop-target-zone').classList.remove('bg-amber-300/80', 'scale-105');
            
            let idx = draggedOptionIndex;
            if (idx === null || idx === undefined) {
                idx = parseInt(e.dataTransfer.getData("text/plain"), 10);
            }
            if (!isNaN(idx)) {
                processMatchingAnswer(idx);
            }
        }

        // Tap fallback for touch screens
        function handleOptionTap(index) {
            if (matchingAnswered) return;
            processMatchingAnswer(index);
        }

        function processMatchingAnswer(selectedIndex) {
            if (matchingAnswered) return;
            matchingAnswered = true;

            const q = matchingQuestions[currentMatchingIndex];
            const selectedOpt = q.options[selectedIndex];

            // Render selected option in drop box
            const dropTarget = document.getElementById('drop-target-zone');
            document.getElementById('drop-zone-placeholder').classList.add('hidden');
            const dropContent = document.getElementById('drop-zone-content');
            dropContent.classList.remove('hidden');
            dropContent.innerHTML = `
                <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border-2 shadow-md">
                    <span class="text-3xl md:text-4xl">${selectedOpt.icon}</span>
                    <span class="text-xs md:text-sm font-extrabold text-slate-800">${selectedOpt.text}</span>
                </div>
            `;

            const cards = document.querySelectorAll('.draggable-card');
            cards.forEach((card, idx) => {
                card.draggable = false;
                card.classList.remove('cursor-grab', 'hover:border-amber-400');
                if (q.options[idx].isCorrect) {
                    card.classList.add('bg-emerald-100', 'border-emerald-500', 'ring-4', 'ring-emerald-300');
                } else if (idx === selectedIndex) {
                    card.classList.add('bg-rose-100', 'border-rose-400', 'ring-4', 'ring-rose-200');
                } else {
                    card.classList.add('opacity-40');
                }
            });

            const feedbackEl = document.getElementById('matching-feedback');
            feedbackEl.classList.remove('hidden');

            if (selectedOpt.isCorrect) {
                playSound('correct');
                if (typeof confetti === 'function') confetti({ particleCount: 50, spread: 70, origin: { y: 0.8 } });
                matchingScore++;
                dropTarget.className = "w-full md:w-64 h-20 md:h-24 border-4 border-emerald-400 bg-emerald-500/40 rounded-2xl flex flex-col items-center justify-center text-center shrink-0 p-1 shadow-lg";
                feedbackEl.className = "flex-1 p-2 md:p-3 rounded-xl text-center font-extrabold text-xs md:text-base border-2 bg-emerald-100 border-emerald-400 text-emerald-900 shadow-sm truncate";
                feedbackEl.innerText = `🎉 ${q.rationale}`;
            } else {
                playSound('wrong');
                dropTarget.className = "w-full md:w-64 h-20 md:h-24 border-4 border-rose-400 bg-rose-500/40 rounded-2xl flex flex-col items-center justify-center text-center shrink-0 p-1 shadow-lg";
                feedbackEl.className = "flex-1 p-2 md:p-3 rounded-xl text-center font-extrabold text-xs md:text-base border-2 bg-rose-100 border-rose-400 text-rose-900 shadow-sm truncate";
                feedbackEl.innerText = `💡 Try again! ${q.rationale}`;
            }

            document.getElementById('btn-next-matching').classList.remove('hidden');
        }

        function nextMatchingQuestion() {
            playSound('click');
            currentMatchingIndex++;
            if (currentMatchingIndex < matchingQuestions.length) {
                loadMatchingQuestion();
            } else {
                showMatchingResults();
            }
        }

        function showMatchingResults() {
            playSound('fanfare');
            document.getElementById('matching-container').classList.add('hidden');
            document.getElementById('matching-header').classList.add('hidden');
            document.getElementById('matching-results').classList.remove('hidden');
            document.getElementById('final-matching-score').innerText = `${matchingScore} / ${matchingQuestions.length}`;
        }

        function restartMatchingGame() {
            playSound('click');
            initMatchingGame();
        }


        /* Activity 2: "What Am I?" Riddle Questions */
        const quizQuestions = [
            {
                question: "I sit on your desk and cannot be carried around. I have a separate monitor, keyboard, and mouse. What am I?",
                options: [
                    { icon: "🖥️", text: "Desktop Computer", isCorrect: true, rationale: "Desktop computers stay on your desk!" },
                    { icon: "💻", text: "Laptop Computer", isCorrect: false, rationale: "Laptops fold closed and carry in a backpack." },
                    { icon: "📱", text: "Tablet Computer", isCorrect: false, rationale: "Tablets are touch screens you carry around." },
                    { icon: "📲", text: "Smartphone", isCorrect: false, rationale: "Smartphones fit in your pocket!" }
                ]
            },
            {
                question: "I am smaller than a desktop. I fold open like a notebook, have a keyboard attached, and fit in your backpack. What am I?",
                options: [
                    { icon: "💻", text: "Laptop Computer", isCorrect: true, rationale: "Laptops fold open like a notebook!" },
                    { icon: "🖥️", text: "Desktop Computer", isCorrect: false, rationale: "Desktops are too large to fit in backpacks." },
                    { icon: "📱", text: "Tablet Computer", isCorrect: false, rationale: "Tablets do not fold open." },
                    { icon: "🤖", text: "Smart Machine", isCorrect: false, rationale: "Robots do not fold closed." }
                ]
            },
            {
                question: "I am a portable touch screen! You tap me with your fingers to draw art, play games, read books & watch movies. What am I?",
                options: [
                    { icon: "🖥️", text: "Desktop Computer", isCorrect: false, rationale: "Desktops stay on desks and use a mouse." },
                    { icon: "📱", text: "Tablet Computer", isCorrect: true, rationale: "Tablets have touch screens for drawing & movies!" },
                    { icon: "📲", text: "Smartphone", isCorrect: false, rationale: "Smartphones are smaller pocket devices." },
                    { icon: "💻", text: "Laptop Computer", isCorrect: false, rationale: "Laptops open up with a physical keyboard." }
                ]
            },
            {
                question: "I am a small pocket computer! I have a touch screen, take photos, and I CAN CALL your family! What am I?",
                options: [
                    { icon: "📲", text: "Smartphone", isCorrect: true, rationale: "Smartphones fit in pockets and make phone calls!" },
                    { icon: "📱", text: "Tablet Computer", isCorrect: false, rationale: "Tablets are too big for small pockets." },
                    { icon: "💻", text: "Laptop Computer", isCorrect: false, rationale: "Laptops cannot fit in pockets!" },
                    { icon: "🖥️", text: "Desktop Computer", isCorrect: false, rationale: "Desktops stay on desks." }
                ]
            },
            {
                question: "I am a smart machine that helps you learn, draw art, listen to music, and play fun games! What am I?",
                options: [
                    { icon: "🤖", text: "Computer", isCorrect: true, rationale: "A computer is a smart machine that helps us learn & play!" },
                    { icon: "📺", text: "Screen Only", isCorrect: false, rationale: "A screen only displays pictures." },
                    { icon: "🔌", text: "Power Cable", isCorrect: false, rationale: "Power cables only bring electricity." },
                    { icon: "🖨️", text: "Printer", isCorrect: false, rationale: "Printers only print paper." }
                ]
            }
        ];

        let currentQuestionIndex = 0;
        let quizScore = 0;
        let answered = false;

        function loadQuestion() {
            answered = false;
            const q = quizQuestions[currentQuestionIndex];
            
            document.getElementById('quiz-question-num').innerText = `Riddle ${currentQuestionIndex + 1} of ${quizQuestions.length}`;
            document.getElementById('quiz-question-text').innerText = q.question;
            document.getElementById('quiz-feedback').classList.add('hidden');
            document.getElementById('btn-next-question').classList.add('hidden');

            // Render 4 Options
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = q.options.map((opt, idx) => `
                <button onclick="selectAnswer(${idx})" 
                        class="quiz-opt-btn group bg-slate-50 border-2 md:border-4 border-slate-200 hover:border-emerald-400 hover:bg-emerald-50 rounded-2xl md:rounded-3xl p-2 md:p-3 flex flex-col items-center justify-center text-center transition-all duration-150 shadow hover:shadow-lg cursor-pointer h-full min-h-0 w-full overflow-hidden">
                    <div class="flex-1 min-h-0 w-full bg-white rounded-xl md:rounded-2xl border-2 border-slate-100 flex items-center justify-center text-5xl md:text-7xl lg:text-8xl my-1 group-hover:scale-105 transition-transform">
                        ${opt.icon}
                    </div>
                    <span class="text-xs md:text-lg font-extrabold text-slate-800 group-hover:text-emerald-800 shrink-0 mt-1">${opt.text}</span>
                </button>
            `).join('');
        }

        function selectAnswer(selectedIndex) {
            if (answered) return;
            answered = true;

            const q = quizQuestions[currentQuestionIndex];
            const selectedOpt = q.options[selectedIndex];
            const buttons = document.querySelectorAll('.quiz-opt-btn');

            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                btn.classList.remove('hover:border-emerald-400', 'cursor-pointer');
                if (q.options[idx].isCorrect) {
                    btn.classList.add('bg-emerald-100', 'border-emerald-500', 'ring-4', 'ring-emerald-300');
                    btn.querySelector('span').classList.add('text-emerald-900');
                } else if (idx === selectedIndex) {
                    btn.classList.add('bg-rose-100', 'border-rose-400', 'ring-4', 'ring-rose-200');
                    btn.querySelector('span').classList.add('text-rose-900');
                } else {
                    btn.classList.add('opacity-40');
                }
            });

            const feedbackEl = document.getElementById('quiz-feedback');
            feedbackEl.classList.remove('hidden');

            if (selectedOpt.isCorrect) {
                playSound('correct');
                if (typeof confetti === 'function') confetti({ particleCount: 50, spread: 70, origin: { y: 0.8 } });
                quizScore++;
                feedbackEl.className = "flex-1 p-2 md:p-3 rounded-xl text-center font-extrabold text-xs md:text-base border-2 bg-emerald-100 border-emerald-400 text-emerald-900 shadow-sm truncate";
                feedbackEl.innerText = `🎉 ${selectedOpt.rationale}`;
            } else {
                playSound('wrong');
                feedbackEl.className = "flex-1 p-2 md:p-3 rounded-xl text-center font-extrabold text-xs md:text-base border-2 bg-rose-100 border-rose-400 text-rose-900 shadow-sm truncate";
                feedbackEl.innerText = `💡 ${selectedOpt.rationale}`;
            }

            document.getElementById('btn-next-question').classList.remove('hidden');
        }

        function nextQuestion() {
            playSound('click');
            currentQuestionIndex++;
            if (currentQuestionIndex < quizQuestions.length) {
                loadQuestion();
            } else {
                showQuizResults();
            }
        }

        function showQuizResults() {
            playSound('fanfare');
            document.getElementById('quiz-container').classList.add('hidden');
            document.getElementById('quiz-header').classList.add('hidden');
            document.getElementById('quiz-results').classList.remove('hidden');
            document.getElementById('final-score-text').innerText = `${quizScore} / ${quizQuestions.length}`;
        }

        function restartQuiz() {
            playSound('click');
            currentQuestionIndex = 0;
            quizScore = 0;
            document.getElementById('quiz-results').classList.add('hidden');
            document.getElementById('quiz-container').classList.remove('hidden');
            document.getElementById('quiz-header').classList.remove('hidden');
            loadQuestion();
        }


        /* Navigation Tab Switching Logic */
        function switchMode(mode) {
            playSound('click');

            document.getElementById('section-slides').classList.add('hidden');
            document.getElementById('section-matching').classList.add('hidden');
            document.getElementById('section-quiz').classList.add('hidden');

            document.getElementById('tab-slides').className = "px-3 py-1.5 md:px-5 md:py-2 rounded-xl font-extrabold text-xs md:text-base text-slate-700 bg-sky-100 hover:bg-sky-200 transition shadow flex items-center gap-1.5";
            document.getElementById('tab-matching').className = "px-3 py-1.5 md:px-5 md:py-2 rounded-xl font-extrabold text-xs md:text-base text-slate-700 bg-amber-100 hover:bg-amber-200 transition shadow flex items-center gap-1.5";
            document.getElementById('tab-quiz').className = "px-3 py-1.5 md:px-5 md:py-2 rounded-xl font-extrabold text-xs md:text-base text-slate-700 bg-emerald-100 hover:bg-emerald-200 transition shadow flex items-center gap-1.5";

            if (mode === 'slides') {
                document.getElementById('section-slides').classList.remove('hidden');
                document.getElementById('tab-slides').className = "px-3 py-1.5 md:px-5 md:py-2 rounded-xl font-extrabold text-xs md:text-base text-white bg-sky-500 hover:bg-sky-600 transition shadow flex items-center gap-1.5";
            } else if (mode === 'matching') {
                document.getElementById('section-matching').classList.remove('hidden');
                document.getElementById('tab-matching').className = "px-3 py-1.5 md:px-5 md:py-2 rounded-xl font-extrabold text-xs md:text-base text-white bg-amber-500 hover:bg-amber-600 transition shadow flex items-center gap-1.5";
                initMatchingGame();
            } else if (mode === 'quiz') {
                document.getElementById('section-quiz').classList.remove('hidden');
                document.getElementById('tab-quiz').className = "px-3 py-1.5 md:px-5 md:py-2 rounded-xl font-extrabold text-xs md:text-base text-white bg-emerald-500 hover:bg-emerald-600 transition shadow flex items-center gap-1.5";
                restartQuiz();
            }
        }

        // Initialize App on DOM load
        window.addEventListener('DOMContentLoaded', () => {
            renderSlide();
        });
    </script>
</body>
</html>
